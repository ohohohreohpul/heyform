{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "heyform": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "heyform" } }],
  "crons": [{ "path": "/health", "schedule": "0 9 * * *" }]
}
